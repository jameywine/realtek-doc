#ifdef CMD_SERDES_GET_ID_SDSID_PAGE_PAGE_REG_REG
//diag configuration
//get configuration
//serdes interface
//serdes index
//page configuration
//page address
//register configuration
//register address
serdes get id <UINT:sdsId> page <UINT:page> reg <UINT:reg>
#endif

#ifdef CMD_SERDES_SET_ID_SDSID_PAGE_PAGE_REG_REG_DATA_DATA
//diag configuration
//set configuration
//serdes interface
//serdes index
//page configuration
//page address
//register configuration
//register address
//data configuration
//data value
serdes set id <UINT:sdsId> page <UINT:page> reg <UINT:reg> data <UINT:data>
#endif





