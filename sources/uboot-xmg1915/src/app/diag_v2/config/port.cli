#ifdef CMD_PORT_SET_COMBO_MODE_PORT_PORTS_ALL_COPPER_FORCE_FIBER_FORCE_AUTO_PREFERRED_COPPER_AUTO_PREFERRED_FIBER_AUTO_PREFERRED_FIBER_BY_GPIO
//port configuration
//set configuration
//combo mode configuration
//port configuration
//port list
//all port
//copper force mode
//fiber force mode
//auto preferred copper media mode
//auto preferred fiber media mode
//auto preferred fiber media mode by software mechanism depend on GPIO
