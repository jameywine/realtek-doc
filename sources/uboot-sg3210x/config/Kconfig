menu "Miscellaneous"
    config CFG_PROMPT
        string "RTL9300 prompt"
        default "RTL9300 # "
        depends on SDK_RTL9300
    config CFG_PROMPT
        string "RTL8390 prompt"
        default "RTL8390 # "
        depends on SDK_RTL8390
    config CFG_PROMPT
        string "RTL8380 prompt"
        default "RTL8380 # "
        depends on RTL838X

    config SYS_TEXT_BASE
        hex "U-Boot Text Base"
        default 0x83F00000

    config BOOTDELAY
        int "Boot Delay, -1 to Disable"
        default -1

    config BOOTCOMMAND
        string "Boot Command"
        default ""

    config BOARDVERSION
        string "Board Version"
        default ""

    config BOARDMODEL
        string "Board Model of Platform"
        default ""

    config BOOTARGS
        string "Booting Arguments"
        default ""

    config POSTWORD
        string "Post Password"
        default ""

    config BAUDRATE
        int "Baudrate"
        default 115200

    config LZMA
        bool "enable LZMA"
        default n

    config ENABLE_SPI_NAND_DRIVER
        bool "enable SPI NAND flash driver"
        default n
        depends on SDK_RTL9300 || SDK_RTL9310

    config RTK_USB_EHCI_HCD
        bool "enable USB EHCI Host controller driver"
        default n
        depends on SDK_RTL9300 || SDK_RTL9310
endmenu

