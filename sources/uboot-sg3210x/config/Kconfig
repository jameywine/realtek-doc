mainmenu "U-Boot Configuration"

config IN_UBOOT
    def_bool y

#############################################################################

menu "SDK Options"
   source ../../../sdk/config/Kconfig.sdk
endmenu

#############################################################################

config MISC_INIT_R
    def_bool y

menu "Board"
    choice
        prompt "Console"
        default UART0

        config UART0
            bool "UART0"
        config UART1
            bool "UART1"
    endchoice

    config INTERRUPT_SUPPORT
        bool "Interrupt Support"
        default n

    choice
        prompt "Boot Type"
        default BOOT_SPI_NOR

        config BOOT_SPI_NOR
            bool "SPI-NOR"
        config BOOT_SPI_NAND
            bool "SPI-NAND"
    endchoice
endmenu

#############################################################################

menu "Supported Commands"
    config CMDLINE_EDITING
        bool "Command Line Editing"
        default y
    config CMD_FLASH
        bool "Flash Utilits"
        default y
    config CMD_MEMORY
        bool "Memory Utilits"
        default y
    config CMD_IMI
        bool "Show Header Information for Application Image"
        default y
    config CMD_ENV
        def_bool n
        depends on (CONFIG_FLASH_SRAM_ONLY = "y") || (CFG_ENV_IS_IN_FLASH != "y")
    config CMD_ENV
        bool y
        depends on (CONFIG_FLASH_SRAM_ONLY != "y") && (CFG_ENV_IS_IN_FLASH = "y")
    config CMD_DUMPREGS
        bool "Display CP0 Registers"
        default n
    # Load from RS-232: BIN Format
    config CMD_LOADB
        def_bool y
    # Load from RS-232: SREC Format
    config CMD_LOADS
        def_bool y
    config CMD_SAVEENV
        def_bool y

    comment "Menu Boot Options"
    config RTK_BOOT
        bool "Enable Menu Boot"
        default y

    config TFTP_DOWNLOAD
        bool "Tftp download"
        default y
        depends on RTK_BOOT
    config SERIAL_DOWNLOAD
        bool "Serial download"
        default n
        depends on RTK_BOOT
    config ICE_DOWNLOAD
        bool "ICE download"
        default n
        depends on RTK_BOOT
    config STANDALONE_APP
        bool "Standalone Application"
        default n
        depends on RTK_BOOT

    config CMD_NET
        def_bool y
        depends on RTK_BOOT && TFTP_DOWNLOAD
    config NET_MULTI
        def_bool y
        depends on RTK_BOOT && CMD_NET
    config AUTOBOOT_PROMPT
        string "autoboot prompt"
        default ""
        depends on RTK_BOOT
    config CMD_RTK
        def_bool y
        depends on RTK_BOOT
    config CMD_RUN
        def_bool y
        depends on RTK_BOOT
endmenu

#############################################################################

menu "Networking"
    config ETHADDR
        string "MAC Address"
        default "00:E0:4C:86:70:01"
    config CMD_NET
        bool "Network Command Support"
        default n
    config CMD_PING
        bool "Ping"
        default y
    config NET_MULTI
        def_bool y
        depends on CMD_NET
    config IPADDR
        string "IP Address"
        default "192.168.1.1"
    config SERVERIP
        string "TFTP Server IP Address"
        default "192.168.1.111"
endmenu

