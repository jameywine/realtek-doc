#
# Makefile for SDK Rtcore Module
#


#
# include configuration file
#
sinclude $(SDK_CONFIG)


#
# path definition
#
DRV_DIR := $(SDK_SYS_DIR)/drv

# decide target file path for kernel or user mode (will change the arch. later, may remove)

ifeq ($(CONFIG_IN_UBOOT),y)
    TGT_DIR :=
else ifeq ($(CONFIG_SDK_KERNEL_LINUX),y)
    ifeq ($(CONFIG_SDK_KERNEL_LINUX_KERNEL_MODE),y)
      TGT_DIR :=
    else ifeq ($(CONFIG_SDK_KERNEL_LINUX_USER_MODE),y)
      TGT_DIR := /user
    else
      $(warning: Should define one of CONFIG_SDK_KERNEL_LINUX_KERNEL_MODE or CONFIG_SDK_KERNEL_LINUX_USER_MODE)
    endif
else
    TGT_DIR :=
endif


COMMON_DIR :=       $(SDK_SYS_DIR)/common
DBG_DIR :=          $(COMMON_DIR)/debug
RTCORE_INIT_DIR :=  $(COMMON_DIR)/rtcore
UTIL_DIR :=         $(COMMON_DIR)/util

GPIO_DIR :=         $(DRV_DIR)/gpio
I2C_DIR :=          $(DRV_DIR)/i2c
INTR_DIR :=         $(DRV_DIR)/intr
RTL8231_DIR :=      $(DRV_DIR)/rtl8231
SPI_DIR :=          $(DRV_DIR)/spi
SWCORE_DIR :=       $(DRV_DIR)/swcore
TC_DIR :=           $(DRV_DIR)/tc
UART1_DIR :=        $(DRV_DIR)/uart
WATCHDOG_DIR :=     $(DRV_DIR)/watchdog

HWP_DIR :=          $(SDK_SYS_DIR)/hwp
IOAL_DIR :=         $(SDK_SYS_DIR)/ioal
ifeq ($(CONFIG_IN_UBOOT),y)
    OSAL_DIR :=         $(SDK_SYS_DIR)/osal/uboot$(TGT_DIR)
else ifeq ($(CONFIG_SDK_KERNEL_LINUX),y)
    OSAL_DIR :=         $(SDK_SYS_DIR)/osal/linux$(TGT_DIR)
else
    OSAL_DIR :=         $(SDK_SYS_DIR)/osal/linux$(TGT_DIR)
endif

IOAL_INIT_DIR := $(IOAL_DIR)$(TGT_DIR)
ifeq ($(CONFIG_SDK_MODEL_MODE),y)
    ifeq ($(CONFIG_SDK_MODEL_MODE_USER),y)
        IOAL_INIT_DIR := $(SDK_DIR)/model/ioal/user
    endif
    ifeq ($(CONFIG_SDK_MODEL_MODE_KERNEL),y)
        IOAL_INIT_DIR := $(SDK_DIR)/model/ioal
    endif
endif

#
# compiler/linker option
#
RTSDK_CFLAGS += -I$(SDK_INCLUDE) -I$(SYS_INCLUDE) -I$(DRV_INCLUDE) -URTK_UNIVERSAL_BSP
ifneq ($(CONFIG_SDK_DRIVER_TEST),)
    RTSDK_CFLAGS += -I$(UT_INCLUDE)
endif

include $(SDK_PATH)/build/Makefile.rtnic_oob

#
# main
#
COMMON_OBJ :=
DRV_OBJ :=
NTFY_OBJ :=
NIC_OBJ :=

COMMON_OBJ += \
	$(COMMON_DIR)/rt_chip.o \
	$(UTIL_DIR)/rt_util_system.o \
    $(UTIL_DIR)/rt_bitop.o \
	$(DBG_DIR)/rt_log.o \
	$(RTCORE_INIT_DIR)/rtcore_init.o

ifneq ($(CONFIG_IN_UBOOT),y)
ifeq ($(CONFIG_SDK_KERNEL_LINUX),y)
    COMMON_OBJ += \
    	$(DBG_DIR)/mem_debug.o
endif
endif

DRV_OBJ += $(DRV_DIR)/drv_mgmt.o

    DRV_OBJ += \
        $(GPIO_DIR)/gpio.o

    ifneq ($(CONFIG_SDK_RTL9310),)
        DRV_OBJ += \
                $(GPIO_DIR)/gpio_common.o
    endif
    ifneq ($(CONFIG_SDK_RTL9311B),)
        DRV_OBJ += \
                $(GPIO_DIR)/gpio_common.o
    endif
    ifneq ($(CONFIG_SDK_RTL9300),)
        DRV_OBJ += \
                $(GPIO_DIR)/gpio_rtl9300.o
    endif
    ifneq ($(CONFIG_SDK_RTL8390),)
        DRV_OBJ += \
                $(GPIO_DIR)/gpio_rtl8390.o
    endif
    ifneq ($(CONFIG_SDK_RTL8380),)
        DRV_OBJ += \
                $(GPIO_DIR)/gpio_rtl8380.o
    endif

    ifeq ($(CONFIG_SDK_KERNEL_LINUX_USER_MODE),y)
        DRV_OBJ += $(GPIO_DIR)/user/rtusr_gpio.o
    endif


    DRV_OBJ += \
        $(I2C_DIR)/i2c.o

        DRV_OBJ += \
            $(I2C_DIR)/i2c_software_drv.o
    ifneq ($(CONFIG_SDK_RTL9300),)
        DRV_OBJ += \
        	$(I2C_DIR)/i2c_rtl9300.o
    endif
    ifneq ($(CONFIG_SDK_RTL9310),)
        DRV_OBJ += \
        	$(I2C_DIR)/i2c_rtl9310.o
    endif
    ifneq ($(CONFIG_SDK_RTL9311B),)
        DRV_OBJ += \
        	$(I2C_DIR)/i2c_rtl9311b.o
    endif
    ifneq ($(CONFIG_SDK_RTL8390),)
        DRV_OBJ += \
        	$(I2C_DIR)/i2c_rtl8390.o
    endif
    ifneq ($(CONFIG_SDK_RTL8380),)
        DRV_OBJ += \
        	$(I2C_DIR)/i2c_rtl8380.o
    endif


    DRV_OBJ += \
        $(INTR_DIR)/intr.o

    ifneq ($(CONFIG_SDK_RTL9310),)
        DRV_OBJ += \
        	$(INTR_DIR)/intr_rtl9310.o
    endif
    ifneq ($(CONFIG_SDK_RTL9311B),)
        DRV_OBJ += \
        	$(INTR_DIR)/intr_rtl9311b.o
    endif
    ifneq ($(CONFIG_SDK_RTL9330),)
        DRV_OBJ += \
                $(INTR_DIR)/intr_rtl9330.o
    endif
    ifneq ($(CONFIG_SDK_RTL9300),)
        DRV_OBJ += \
        	$(INTR_DIR)/intr_rtl9300.o
    endif
    ifneq ($(CONFIG_SDK_RTL8390),)
        DRV_OBJ += \
        	$(INTR_DIR)/intr_rtl8390.o
    endif
    ifneq ($(CONFIG_SDK_RTL8380),)
        DRV_OBJ += \
        	$(INTR_DIR)/intr_rtl8380.o
    endif

ifneq ($(CONFIG_IN_UBOOT),y)
    DRV_OBJ += $(UTIL_DIR)/rt_util_intr.o

  ifneq ($(CONFIG_SDK_KERNEL_LINUX_USER_MODE),y)
    DRV_OBJ += $(UTIL_DIR)/rt_util_intrk.o
  endif
endif

NTFY_DIR    := $(DRV_DIR)/l2ntfy
NTFY_USR_DIR:= $(DRV_DIR)/l2ntfy/user
NIC_DIR     := $(DRV_DIR)/nic
NIC_KRN_DIR := $(DRV_DIR)/nic
include $(SDK_PATH)/build/Makefile.rtnic


    DRV_OBJ += \
    	$(GPIO_DIR)/ext_gpio.o \
        $(RTL8231_DIR)/rtl8231.o

    ifneq ($(CONFIG_SDK_RTL9310),)
        DRV_OBJ += \
                $(RTL8231_DIR)/rtl8231_rtl9310.o
    endif
    ifneq ($(CONFIG_SDK_RTL9311B),)
        DRV_OBJ += \
                $(RTL8231_DIR)/rtl8231_rtl9311b.o
    endif
    ifneq ($(CONFIG_SDK_RTL9300),)
        DRV_OBJ += \
        	$(RTL8231_DIR)/rtl8231_rtl9300.o
    endif
    ifneq ($(CONFIG_SDK_RTL8390),)
        DRV_OBJ += \
        	$(RTL8231_DIR)/rtl8231_rtl8390.o
    endif
    ifneq ($(CONFIG_SDK_RTL8380),)
        DRV_OBJ += \
        	$(RTL8231_DIR)/rtl8231_rtl8380.o
    endif

    DRV_OBJ += $(GPIO_DIR)/generalCtrl_gpio.o

ifeq ($(CONFIG_SDK_DRIVER_SPI),y)
    DRV_OBJ += $(SPI_DIR)/spi.o
    ifeq ($(CONFIG_SDK_KERNEL_LINUX_KERNEL_MODE),y)
    ifeq ($(CONFIG_SDK_BSP_SPI_DRV),y)
        DRV_OBJ += $(SPI_DIR)/spi-controller-driver.o
    endif
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_1),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev1.o
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_2),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev2.o
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_3),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev3.o
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_4),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev4.o
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_5),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev5.o
        DRV_OBJ += $(SPI_DIR)/spi_dev3.o
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_6),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev6.o
    endif
    ifeq ($(CONFIG_SDK_SPI_DEV_7),y)
        DRV_OBJ += $(SPI_DIR)/spi_dev7.o
    endif
endif

ifneq ($(CONFIG_SDK_MINISDK_PHY),y)
ifeq ($(CONFIG_SDK_KERNEL_LINUX),y)
  ifneq ($(KERNELRELEASE),)
    #this is linux mode, and in kernel space (i.e. lkm)

    ifeq ($(CONFIG_SDK_EXTERNAL_CPU),y)
        DRV_OBJ += $(SWCORE_DIR)/chip_probe.o
    endif
  else
    #this is linux mode, and in user space
    DRV_OBJ += $(SWCORE_DIR)/chip_probe.o
  endif
else
    #this is non-linux mode or loader
    DRV_OBJ += $(SWCORE_DIR)/chip_probe.o
endif
endif

ifneq ($(CONFIG_SDK_MINISDK_PHY),y)
    DRV_OBJ += $(SWCORE_DIR)/swcore.o
endif

    DRV_OBJ += $(TC_DIR)/tc.o\
               $(TC_DIR)/tc_common.o
  ifeq ($(CONFIG_SDK_TC_TC1_TIME),y)
    	    DRV_OBJ += $(UTIL_DIR)/rt_util_time.o
    ifeq ($(CONFIG_SDK_KERNEL_LINUX_KERNEL_MODE),y)
    	    DRV_OBJ += $(UTIL_DIR)/rt_util_timeIsr.o
    endif
  endif

ifneq ($(CONFIG_IN_UBOOT),y)
    DRV_OBJ += \
    	$(UART1_DIR)/uart.o \
        $(UART1_DIR)/uart_common.o
endif

ifneq ($(CONFIG_IN_UBOOT),y)
DRV_OBJ += \
    $(WATCHDOG_DIR)/watchdog.o \
    $(WATCHDOG_DIR)/watchdog_common.o
endif

HWP_OBJ := \
    $(HWP_DIR)/hwp_init.o \
    $(HWP_DIR)/hwp_probe.o \
    $(HWP_DIR)/hwp.o \
    $(HWP_DIR)/profile_list.o


IOAL_OBJ := \
    $(IOAL_INIT_DIR)/ioal_init.o \
	$(IOAL_DIR)/mem32.o \
	$(IOAL_DIR)/phy_reset.o \
    $(IOAL_DIR)/ioal_param.o \
    $(IOAL_DIR)/ioal_log.o

ifeq ($(CONFIG_SDK_KERNEL_LINUX),y)
OSAL_OBJ := \
	$(OSAL_DIR)/atomic.o \
	$(OSAL_DIR)/cache.o \
	$(OSAL_DIR)/cpu.o \
	$(OSAL_DIR)/memory.o \
	$(OSAL_DIR)/sem.o \
	$(OSAL_DIR)/thread.o \
	$(OSAL_DIR)/time.o \
	$(OSAL_DIR)/wait.o

  ifeq ($(CONFIG_SDK_KERNEL_LINUX_KERNEL_MODE),y)
    OSAL_OBJ += \
	    $(OSAL_DIR)/spl.o \
		$(OSAL_DIR)/isr.o
  endif
endif

ifeq ($(CONFIG_IN_UBOOT),y)
OSAL_OBJ := \
	$(OSAL_DIR)/cache.o \
	$(OSAL_DIR)/cpu.o \
	$(OSAL_DIR)/memory.o \
	$(OSAL_DIR)/sem.o \
	$(OSAL_DIR)/thread.o \
	$(OSAL_DIR)/time.o \
	$(OSAL_DIR)/spl.o
endif

ifeq ($(CONFIG_SDK_MODEL_MODE),y)
    RTSDK_CFLAGS += -I$(MODEL_PATH)
    ifeq ($(CONFIG_SDK_RTL9300),y)
        RTSDK_CFLAGS += -I$(MODEL_PATH)/behavior_src/9300
    endif
    ifeq ($(CONFIG_SDK_RTL9310),y)
        RTSDK_CFLAGS += -I$(MODEL_PATH)/behavior_src/9310
    endif
    ifeq ($(CONFIG_SDK_RTL9311B),y)
        RTSDK_CFLAGS += -I$(MODEL_PATH)/behavior_src/9311b
    endif
    RTSDK_CFLAGS += -I$(MODEL_PATH)/common
    IOAL_OBJ += $(MODEL_DIR)/virtualmac/vmac_target.o
endif

RTCORE_OBJ := $(COMMON_OBJ) $(DRV_OBJ) $(HWP_OBJ) $(IOAL_OBJ) $(OSAL_OBJ) $(NIC_OBJ) $(NTFY_OBJ) $(NIC_OOB_ALL_OBJ)

